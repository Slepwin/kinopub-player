{
  "name": "kinopub-player",
  "version": "1.0.0",
  "description": "Kino.pub player in Media Player Classic style",
  "main": "src/main/main.js",
  "author": "slepwin <slepwinvg@gmail.com>",
  "homepage": "https://github.com/Slepwin/kinopub-player",
  "desktopName": "kinopub-player",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux --x64",
    "dist:deb": "electron-builder --linux deb --x64",
    "dist:arch": "electron-builder --linux pacman --x64"
  },
  "build": {
    "appId": "com.slepwin.kinopub-player",
    "productName": "KinoPub Player",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb", "pacman"],
      "category": "AudioVideo",
      "syncDesktopName": true,
      "maintainer": "slepwin <slepwinvg@gmail.com>",
      "synopsis": "Kino.pub player in Media Player Classic style"
    },
    "deb": {
      "packageName": "kinopub-player",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "pacman": {
      "packageName": "kinopub-player"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "hls.js": "^1.5.17"
  }
}
